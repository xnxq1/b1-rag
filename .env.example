# --- OpenRouter: LLM, эмбеддинги и реранкер через один ключ ---
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

LLM_MODEL=openai/gpt-4.1-mini
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
# function_calling | json_schema | json_mode
LLM_STRUCTURED_METHOD=function_calling

EMBEDDING_MODEL=openai/text-embedding-3-large
# должна совпадать с размерностью модели; при смене — новая QDRANT_COLLECTION и переиндексация
EMBEDDING_DIM=3072
EMBEDDING_BATCH_SIZE=64

RERANK_MODEL=cohere/rerank-v3.5
# сколько кандидатов после слияния ветвей идёт в реранкер
RERANK_CANDIDATES=30
# сколько лучших фрагментов после реранкера может попасть в контекст LLM
RERANK_TOP_N=5
# порог релевантности реранкера: ниже — фрагмент в контекст не попадает
RERANK_MIN_SCORE=0.05

# --- гибридный поиск ---
# rrf | dbsf
SEARCH_FUSION=rrf
SEARCH_DENSE_LIMIT=30
SEARCH_SPARSE_LIMIT=30
BM25_LANGUAGE=russian
BM25_AVG_LEN=150

# --- нарезка ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- инфраструктура (в docker-compose переопределяются на адреса сервисов) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=chunks
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=./data/uploads
MAX_UPLOAD_BYTES=52428800
MAX_PAGES=100

RETRY_ATTEMPTS=6
RETRY_MAX_WAIT_SECONDS=10

# повтор задачи индексации при временной недоступности внешних сервисов: 30 → 60 → 120 → 240 с
INDEX_TASK_MAX_RETRIES=4
INDEX_TASK_RETRY_BACKOFF_SECONDS=30
INDEX_TASK_RETRY_MAX_BACKOFF_SECONDS=600
LOG_LEVEL=INFO
